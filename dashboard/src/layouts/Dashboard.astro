---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
interface Props { title?: string }
const { title = 'ccusage-cloud' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#183b30" />
    <meta name="description" content="A personal workspace for understanding AI usage across your devices, sources, and projects." />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>
